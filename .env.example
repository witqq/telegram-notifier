# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Private owner destination. TELEGRAM_CHAT_ID remains a legacy fallback for owner only.
TELEGRAM_OWNER_CHAT_ID=your_private_chat_id_here

# Public channel destination. Never falls back to the private destination.
TELEGRAM_CHANNEL_CHAT_ID=@your_channel_username
